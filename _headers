# Cheap default for HTML: revalidate every time so a redeploy is picked up
# immediately, but let Cloudflare's edge serve the cached copy meanwhile.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprint-free asset paths, so cache hard but allow revalidation. Long
# max-age here is what keeps repeat visits (and Core Web Vitals) fast.
/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Crawler-facing files. Keep them fresh so a sitemap or policy change is seen
# on the next crawl rather than a week later.
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: index, follow
